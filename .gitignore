# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ML artifacts — never commit weights, checkpoints or run output
checkpoints/
runs/
outputs/
wandb/
mlruns/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf
wan_smoke_report.json

# Data: only the small synthetic fixtures are tracked (regenerate with
# scripts/record_mock_dataset.py). Real recordings never go into git.
data/raw/
data/episodes/
datasets/*
!datasets/mock-d0/
!datasets/mock-d1/

# Third-party models fetched, never vendored: the MuJoCo Menagerie unitree_g1 description
# is ~38 MB of meshes under Unitree's own BSD-3-Clause license (see the LICENSE inside the
# folder). Recreate with: .venv/bin/python scripts/fetch_g1_model.py
assets/

# Vendored third-party trainer trees. `third_party/patches/` IS tracked — the patches are the
# provenance record (docs/handoff.md §3) — but the tree they apply to is a build artifact: a full
# upstream clone at a pinned sha, rebuilt by cluster/discoverer/72_build_t39_env.sbatch there and
# scripts/build_t39_env_local.sh here. Committing it would vendor NVIDIA's history into ours, and
# PROVENANCE.json + the patch sha256 already pin exactly which tree was built.
third_party/*
!third_party/patches/

# Internal documents (PRD etc.) — this repository is public
idea/

# Secrets / credentials (HF tokens, robot access)
.env
.env.*
!.env.example
*.secrets
*.pem
.hf_token

# OS / editor (.idea = JetBrains, not the idea/ docs folder above)
.DS_Store
.idea/
.vscode/

# MuJoCo writes a global warning log next to the cwd
MUJOCO_LOG.TXT
