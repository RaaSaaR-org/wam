#!/bin/bash
# Step 20 — apple pick-and-place variations. EXPLORATORY. NOT PR-09, NOT SCORED.
#
#   T041_FREEZE_LIFTED="<reason>" sbatch 96_generate_apple_variations.sbatch
#
# WHAT THIS IS. 15 prompts about the G1 Dex3 apple pick-and-place task, generated by both arms
# (stock Cosmos3-Super and the T-041 adapter) at the settings PR-09 registered, so the clips are
# comparable to the eval clips and to each other. Output is 30 mp4s and an index. There is no
# judge, no rubric, no gate and no verdict: nothing this job writes can pass or fail anything.
#
# WHAT IT MUST NOT BECOME. PR-09's evidence lives in ${PROJ}/runs/t041-super-lora/eval and this
# job never opens that directory -- it writes to a run id of its own. The distinction matters
# because the two produce the same kind of file: an mp4 of a G1 arm, from a caption, by one of two
# arms. What separates the eval's 60 from these 30 is that the eval's prompt set, sampler settings
# and scoring rule were fixed before anything was generated. These 30 were chosen afterwards, by
# someone who has seen the eval. They are worth looking at and they are not evidence, and mixing
# them into that directory would destroy the only property that makes the other set evidence.
#
# APPLE IS IN THE FINE-TUNE CORPUS -- g1-dex3-pickapple-dataset, 198 clips (197 train / 1 val).
# So this is the adapter on home ground, not a generalisation test. EXACTLY ONE of the fifteen
# prompts is a caption the adapter never trained on; four are training captions labelled
# real-train in the index, and the other ten are edits or reseeds of a training caption. Do not
# read any of them except the single real-heldout row as evidence about held-out behaviour.
#
#SBATCH --job-name=wam-t041-apple
#SBATCH --partition=common
#SBATCH --account=ehpc-aif-2026pg01-905
#SBATCH --qos=ehpc-aif-2026pg01-905
# ~30 min of work: two checkpoint loads (~3 min each on the HF path, measured on job 187305) plus
# ceil(16/8) = 2 sequential generations per rank per arm at ~100 s each. 1.5 h is headroom for a
# cold page cache, not an estimate, and a short request backfills sooner than the 4 h ceiling.
#SBATCH --time=01:30:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=208
# dgx1 is the only node with gpu:8 -- dgx2 advertises gpu:7,gpu_biz:1.
#SBATCH --gres=gpu:8
#SBATCH --mem=1800G
#SBATCH --requeue
#SBATCH --open-mode=append
#SBATCH -o /valhalla/projects/ehpc-aif-2026pg01-905/logs/t041-apple.%j.out

set -euo pipefail
source /valhalla/projects/ehpc-aif-2026pg01-905/caches.sh
source "${PROJ}/cosmos_env.sh"

: "${FRAMEWORK:?90_build_cosmos_env.sbatch has not run -- no cosmos-framework checkout or venv.}"
: "${FFMPEG_PREFIX:?90_build_cosmos_env.sbatch has not run -- no ffmpeg.}"
: "${DATASET_PATH:?no corpus registered -- run sync.sh --corpus then sbatch 92b_register_corpus.sbatch}"
: "${T041_FREEZE_LIFTED:?PR-07 §7 freezes Cosmos3-Super. Set T041_FREEZE_LIFTED to the reason.}"
echo "=== freeze lifted: ${T041_FREEZE_LIFTED}"

module purge
module load anaconda3/python3.12
module load nvidia/cuda/12/12.8
export PATH=${FFMPEG_PREFIX}/bin:${PATH}
export LD_LIBRARY_PATH=""
export PYTORCH_ALLOC_CONF=expandable_segments:True
# 26 threads per GPU is the hard cap on this allocation; exceeding it strands GPU-hours.
export OMP_NUM_THREADS=26
nvidia-smi -L

NPROC=${NPROC:-8}
TRAIN_RUN=${TRAIN_RUN:-t041-super-lora}
RUN_ID=${RUN_ID:-t041-apple-variations}
SRC=${PROJ}/runs/${TRAIN_RUN}
OUT=${PROJ}/runs/${RUN_ID}
RUN_DIR=${SRC}/train/cosmos3/sft/vision_sft_super
LORA_MODEL=${LORA_MODEL:-${RUN_DIR}/model}
BASE_MODEL=${BASE_MODEL:-${PROJ}/checkpoints/Cosmos3-Super-hf}
WAM=${PROJ}/wam
# Read for the generation block only. The [selection] block is PR-09's and is not consulted here:
# this job's prompt set is built by a different script under a different rule. Sharing the sampler
# settings is the point -- steps, guidance, shift, fps, num_frames and geometry identical to the
# eval means these clips can be put next to those without a caveat about the sampler.
CONFIG=${WAM}/configs/cosmos3/t041_eval_selection.toml
PROMPTS=${OUT}/apple_variation_prompts.jsonl

[[ -f "${SRC}/DONE" ]] || { echo "FATAL: ${SRC}/DONE missing -- training did not complete."; exit 1; }
[[ -f "${BASE_MODEL}/config.json" ]] || {
  echo "FATAL: ${BASE_MODEL}/config.json missing. That file is what makes CheckpointType.from_path"
  echo "       return 'hf'; the DCP tree at BASE_CHECKPOINT_PATH is not loadable by inference."
  exit 1; }
[[ -d "${LORA_MODEL}" ]] || { echo "FATAL: ${LORA_MODEL} missing -- export the adapter first."; exit 1; }
mkdir -p "${OUT}"
source "${FRAMEWORK}/.venv/bin/activate"

# -- 1. prompts ----------------------------------------------------------------------------------
if [[ ! -f "${PROMPTS}" ]]; then
  python "${WAM}/scripts/make_apple_variation_prompts.py" --corpus "${DATASET_PATH}" -o "${PROMPTS}"
fi
echo "=== prompts $(wc -l < "${PROMPTS}")  sha256 $(cat "${PROMPTS}.sha256")"

# -- 2. generate, both arms ------------------------------------------------------------------------
cd "${FRAMEWORK}"

# Lifted verbatim from 95_eval_t041_embodiment.sbatch. Files any clip the framework finished, and
# leaves the rest in a missing-list which is the only thing handed to torchrun -- so a requeue
# regenerates exactly what is absent. sample_outputs.json is written strictly after the mp4 is
# asserted to exist, and carries status "error" when _handle_sample_exception wrote it, which is
# why the status is read rather than the file merely counted.
harvest() {  # payload-dir  raw-dir  dest-dir  missing-list-to-write
python - "$1" "$2" "$3" "$4" <<'PY'
import json, pathlib, shutil, sys
pay, raw, dest, out = (pathlib.Path(a) for a in sys.argv[1:5])
missing = []
for p in sorted(pay.glob("*.json")):
    if (dest / f"{p.stem}.mp4").is_file():
        continue
    src, rec = raw / p.stem / "vision.mp4", raw / p.stem / "sample_outputs.json"
    ok = False
    if src.is_file() and rec.is_file():
        try:
            ok = json.loads(rec.read_text()).get("status") == "success"
        except ValueError:
            ok = False
    if ok:
        shutil.move(str(src), str(dest / f"{p.stem}.mp4"))
    else:
        missing.append(p.stem)
out.write_text("".join(f"{u}\n" for u in missing))
print(f"harvest: {len(list(dest.glob('*.mp4')))} clips filed, {len(missing)} to generate")
PY
}

for ARM in base lora; do
  CKPT=$([[ "${ARM}" == base ]] && echo "${BASE_MODEL}" || echo "${LORA_MODEL}")
  DEST=${OUT}/clips/${ARM}
  RAW=${DEST}/_raw
  MISSING=${OUT}/payloads/${ARM}.missing
  mkdir -p "${DEST}" "${RAW}" "${OUT}/payloads/${ARM}"
  echo "=== generating arm ${ARM} from ${CKPT}"
  # THE SEED COMES FROM THE PROMPT ROW, NOT THE CONFIG -- the one deliberate difference from 95.
  # The seed family varies it on purpose, so a single --seed on the torchrun line would collapse
  # those four clips into one repeated output. Every other setting is read from the config, so the
  # two arms cannot differ in anything except which checkpoint produced them.
  python - "${PROMPTS}" "${CONFIG}" "${OUT}/payloads/${ARM}" <<'PY'
import json, pathlib, sys, tomllib
prompts, cfg_path, dest = sys.argv[1], sys.argv[2], pathlib.Path(sys.argv[3])
g = tomllib.loads(pathlib.Path(cfg_path).read_text())["generation"]
n = 0
for line in pathlib.Path(prompts).read_text().splitlines():
    if not line.strip():
        continue
    p = json.loads(line)
    payload = {"model_mode": g["model_mode"], "name": p["uuid"], "prompt": p["prompt"],
               "negative_prompt": "", "enable_sound": g["enable_sound"],
               "num_steps": g["num_steps"], "guidance": g["guidance"], "shift": g["shift"],
               "fps": g["fps"], "num_frames": g["num_frames"], "resolution": g["resolution"],
               "aspect_ratio": g["aspect_ratio"], "seed": p["seed"]}
    (dest / f"{p['uuid']}.json").write_text(json.dumps(payload, indent=2) + "\n")
    n += 1
written = len(list(dest.glob('*.json')))
assert written == n, f"{n} prompts but {written} payloads: duplicate name, or stale payloads in {dest}"
print("payloads:", written)
PY
  PRESET=$(python -c "import tomllib,pathlib;print(tomllib.loads(pathlib.Path('${CONFIG}').read_text())['generation']['parallelism_preset'])")
  harvest "${OUT}/payloads/${ARM}" "${RAW}" "${DEST}" "${MISSING}"
  if [[ -s "${MISSING}" ]]; then
    TODO=()
    while IFS= read -r U; do TODO+=("${OUT}/payloads/${ARM}/${U}.json"); done < "${MISSING}"
    echo "=== arm ${ARM}: one load, ${#TODO[@]} clips"
    # --no-guardrails: nvidia/Cosmos-Guardrail1 is a GATED repo with no accepted licence on this
    # allocation (job 187249 died on it), and its RetinaFace post-processor rewrites the returned
    # frames -- a false positive on 320x256 robot footage blurs the hand, which is the one region
    # anyone looking at these clips is looking at.
    torchrun --nproc-per-node="${NPROC}" -m cosmos_framework.scripts.inference \
        --parallelism-preset="${PRESET}" -i "${TODO[@]}" -o "${RAW}" \
        --checkpoint-path "${CKPT}" --no-guardrails
    harvest "${OUT}/payloads/${ARM}" "${RAW}" "${DEST}" "${MISSING}"
  else
    echo "=== arm ${ARM}: every clip already on disk -- no checkpoint load"
  fi
  if [[ -s "${MISSING}" ]]; then
    echo "FATAL: arm ${ARM} still missing $(wc -l < "${MISSING}") clips:"; head -5 "${MISSING}"; exit 1
  fi
  echo "=== arm ${ARM}: $(find "${DEST}" -maxdepth 1 -name '*.mp4' | wc -l) clips"
done

# -- 3. index --------------------------------------------------------------------------------------
# Not blinded, and it says so. The eval's items/ + key.json split exists so a scorer cannot see
# which arm made a clip; nothing here is scored, so hiding the arm would only make the clips
# harder to look at. If these prompts are ever scored, they need a fresh blinded sheet.
python - "${PROMPTS}" "${OUT}" <<'PY'
import json, pathlib, sys
prompts, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
rows = [json.loads(l) for l in prompts.read_text().splitlines() if l.strip()]
index = []
for r in rows:
    entry = {k: r[k] for k in ("uuid", "family", "base_uuid", "seed", "note")}
    for arm in ("base", "lora"):
        p = out / "clips" / arm / f"{r['uuid']}.mp4"
        entry[arm] = str(p.relative_to(out)) if p.is_file() else None
        entry[f"{arm}_bytes"] = p.stat().st_size if p.is_file() else 0
    index.append(entry)
(out / "index.json").write_text(json.dumps(
    {"run": out.name, "blinded": False, "scored": False,
     "note": "Exploratory apple pick-and-place variations. NOT PR-09 evidence.",
     "prompts_sha256": (prompts.parent / (prompts.name + ".sha256")).read_text().strip(),
     "items": index}, indent=2) + "\n")
missing = [e["uuid"] for e in index if not (e["base"] and e["lora"])]
print(f"index: {len(index)} prompts, {sum(bool(e['base']) for e in index)} base, "
      f"{sum(bool(e['lora']) for e in index)} lora")
if missing:
    print("INCOMPLETE pairs:", missing[:5])
PY

echo
echo "=== apple variations done:  ${OUT}"
echo "    clips/base/<name>.mp4   clips/lora/<name>.mp4   index.json"
echo "These are a demo, not a measurement. PR-09's verdict is unaffected and unchanged."
